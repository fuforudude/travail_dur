# Configuration de l'API (copier en server/.env en local, en /opt/travail-dur-api/.env sur le VPS).

# Supabase → Connect → « Transaction pooler » (port 6543) : copier l’adresse donnée, avec le mot de passe de la base.
# Certificat : Database → Settings → SSL Configuration → Download certificate, copié à côté de l'API.
DATABASE_URL=postgresql://postgres.wyawthtpqybhejlkaolt:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/opt/travail-dur-api/supabase-ca.crt

# Adresse du projet : sert à vérifier les jetons de connexion des joueurs (clés publiques JWKS).
SUPABASE_URL=https://wyawthtpqybhejlkaolt.supabase.co
# Seulement si le projet signe encore ses jetons avec l'ancien secret partagé (Settings → JWT Keys → Legacy JWT secret).
# SUPABASE_JWT_SECRET=

# Sites autorisés à appeler l'API (CORS), séparés par des virgules.
ALLOWED_ORIGINS=https://fuforudude.github.io,http://localhost:5173

PORT=8787
HOST=127.0.0.1
