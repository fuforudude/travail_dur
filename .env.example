# Copier ce fichier en .env.local et renseigner les valeurs de votre projet Supabase.
# Sans ces variables, le solo fonctionne et le multijoueur est désactivé.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# API du site (server/, sur le VPS ; en local : npm run server:dev). Sans elle, l'appart est indisponible.
VITE_API_URL=http://localhost:8787
